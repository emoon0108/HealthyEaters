function show_games(self)
	sync_wallet(self)
	clear_screen(self)
	self.screen = "games"
	add_screen_background(self)
	add_text(self, "view_title", "Food practice lab", 640, 662, 700, 52, COLORS.leaf_dark, 1.65)
	add_floating_image(self, "games_icon", "icon_games", 360, 662, 76, 76, 8, 1.4, 0)
	add_floating_image(self, "token_icon", "icon_token", 920, 662, 66, 66, 8, 1.3, 0.2)
	self.wallet_node = add_text(self, "view_wallet", "", 640, 616, 520, 34, COLORS.leaf_dark, 1)
	update_wallet(self)
	add_glass_card(self, "arcade_marquee", 640, 570, 900, 52, COLORS.glass)
	add_text(self, "games_hint", "Choose a short round. Meal check-ins open longer practice sets.", 640, 570, 800, 34, COLORS.text, 0.86)
	add_floating_image(self, "arcade_star_left", "decor_star", 225, 570, 42, 42, 7, 1.4, 0)
	add_floating_image(self, "arcade_star_right", "decor_star", 1055, 570, 42, 42, 7, 1.4, 0.2)

	add_glass_card(self, "arcade_floor", 640, 318, 1120, 348, vmath.vector4(0.74, 0.96, 0.88, 0.72))
	for i, game in ipairs(games.all()) do
		local col = (i - 1) % 5
		local row = math.floor((i - 1) / 5)
		local x = 190 + col * 225
		local y = 406 - row * 168
		add_arcade_card(self, game, i, x, y)
	end

	add_glass_card(self, "arcade_tip", 640, 88, 700, 50, COLORS.glass)
	add_text(self, "arcade_tip_text", "Finish a recharge meal to earn tokens, then come back for another cabinet.", 640, 88, 630, 30, COLORS.text, 0.7)
	add_button(self, "home", "Bito Home", 360, 34, 200, 42, COLORS.leaf, function() show_home(self) end)
	add_button(self, "shop", "Bot Upgrades", 640, 34, 200, 42, COLORS.gold, function() show_shop(self) end)
	add_button(self, "meal", "Recharge", 920, 34, 200, 42, COLORS.coral, function()
		show_home(self)
		msg.post("#script", "start_meal")
	end)
end

function show_game_start(self, game_id)
	sync_wallet(self)
	local game = games.get(game_id)
	if not game then
		show_message(self, "Game Missing", "I could not find that game.", function() show_games(self) end)
		return
	end
	clear_screen(self)
	self.screen = "game_start"
	add_screen_background(self)
	add_glass_card(self, "start_panel", 640, 390, 820, 390, COLORS.glass)
	add_text(self, "game_title", game.name, 640, 525, 720, 54, COLORS.leaf_dark, 1.65)
	local bridge = self.last_food and ("\nPlate bridge: " .. self.last_food .. " can show up as a power-up.") or ""
	add_text(self, "game_desc", game.desc .. bridge .. "\n\nLonger challenge: about " .. game.duration .. " seconds\nCost: " .. game.cost .. " token(s)\nReward: +" .. game.point_reward .. " points", 640, 410, 660, 150, COLORS.text, 1)
	self.wallet_node = add_text(self, "view_wallet", "", 640, 235, 520, 34, COLORS.leaf_dark, 1)
	update_wallet(self)
	add_button(self, "start_game", "Play", 500, 160, 220, 52, COLORS.coral, function()
		local session, err = games.start_session(game_id)
		if not session then
			show_message(self, "Need Tokens", "Finish a meal check-in first to earn practice tokens.", function() show_home(self) end)
			return
		end
		local rounds = GAME_ROUNDS[game_id] or {}
		local plate_round = bridge_round(self.last_food)
		if plate_round then
			local bridged_rounds = { plate_round }
			for _, round in ipairs(rounds) do
				bridged_rounds[#bridged_rounds + 1] = round
			end
			rounds = bridged_rounds
		end
		self.active_game = {
			session = session,
			rounds = rounds,
			round = 1,
			score = 0,
			lives = 3,
			target_score = game_id == "garden_catch" and 15 or 8,
			time_left = math.min(90, math.max(45, session.game.duration or 60)),
			mode = game_id == "garden_catch" and "garden_catch" or "action",
			basket_x = 640,
			falling = {},
			spawn_timer = 0,
			spawn_count = 1,
			garden_rendered = false,
			feedback = "",
		}
		sync_wallet(self)
		show_game_transition(self, 1)
	end)
	add_button(self, "back_games", "Back", 780, 160, 220, 52, COLORS.leaf, function() show_games(self) end)
end

function show_game_transition(self, step)
	clear_screen(self)
	self.screen = "game_transition"
	local words = { "Ready", "Set", "Go" }
	add_screen_background(self)
	add_glass_card(self, "transition_panel", 640, 380, 700, 300, COLORS.glass)
	add_text(self, "transition_title", words[step] or "Go", 640, 425, 560, 90, COLORS.leaf_dark, 2.0)
	add_text(self, "transition_copy", "Switching from meal time to game time.", 640, 335, 560, 40, COLORS.text, 1)
	timer.delay(self.low_stim and 0.9 or 0.55, false, function()
		if step < 3 then
			show_game_transition(self, step + 1)
		else
			show_game_round(self)
		end
	end)
end

function show_game_round(self)
	local active = self.active_game
	if not active or not active.rounds then
		show_games(self)
		return
	end
	if active.mode == "garden_catch" then
		if active.score >= active.target_score or active.lives <= 0 or active.time_left <= 0 then
			show_game_complete(self)
			return
		end
		clear_screen(self)
		self.screen = "game_round"
		add_screen_background(self)
		add_text(self, "game_title", "Garden Catch", 640, 650, 720, 50, COLORS.leaf_dark, 1.55)
		self.action_hud_node = add_text(self, "action_hud", "Healthy caught " .. active.score .. "/" .. active.target_score .. "    Lives " .. active.lives .. "    Time " .. math.ceil(active.time_left), 640, 604, 900, 36, COLORS.leaf, 0.9)
		add_glass_card(self, "garden_arena", 640, 355, 1000, 420, COLORS.glass)
		add_box(self, "good_lane", 335, 548, 330, 58, vmath.vector4(0.44, 0.86, 0.58, 0.8))
		add_text(self, "good_label", "CATCH HEALTHY FOODS", 335, 548, 300, 28, COLORS.white, 0.68)
		add_box(self, "bad_lane", 945, 548, 330, 58, vmath.vector4(1.0, 0.36, 0.25, 0.78))
		add_text(self, "bad_label", "AVOID DESSERTS", 945, 548, 300, 28, COLORS.white, 0.68)
		add_text(self, "garden_feedback", "Click or drag to move the basket. Catch GOOD foods. Let AVOID desserts fall past.", 640, 500, 820, 32, COLORS.text, 0.78)
		self.basket_node = add_box(self, "basket", active.basket_x, 105, 170, 54, COLORS.gold)
		add_box(self, "basket_mouth", active.basket_x, 130, 190, 20, COLORS.coral)
		self.basket_label_node = add_text(self, "basket_label", "BASKET", active.basket_x, 103, 130, 24, COLORS.leaf_dark, 0.56)
		active.garden_rendered = true
		active.falling = {}
		active.spawn_timer = 0
		active.spawn_count = 1
		for i = 1, 5 do
			spawn_garden_catch_item(self, active)
			active.falling[i].y = 560 - (i * 78)
		end
		add_button(self, "quit_game", "Exit Game", 640, 42, 220, 42, COLORS.leaf_dark, function()
			self.active_game = nil
			show_games(self)
		end)
		return
	end
	if active.mode == "action" then
		if active.score >= active.target_score or active.lives <= 0 or active.time_left <= 0 then
			show_game_complete(self)
			return
		end
		local round = active.rounds[active.round]
		if not round then
			active.round = 1
			round = active.rounds[active.round]
		end

		clear_screen(self)
		self.screen = "game_round"
		local game = active.session.game
		add_screen_background(self)
		add_text(self, "game_title", game.name, 640, 650, 720, 50, COLORS.leaf_dark, 1.55)
		self.action_hud_node = add_text(self, "action_hud", "Score " .. active.score .. "/" .. active.target_score .. "    Lives " .. active.lives .. "    Time " .. math.ceil(active.time_left), 640, 604, 760, 36, COLORS.leaf, 0.95)
		add_glass_card(self, "action_arena", 640, 388, 920, 340, COLORS.glass)
		add_text(self, "action_prompt", round.prompt, 640, 505, 760, 70, COLORS.text, 1.02)
		add_text(self, "action_feedback", active.feedback ~= "" and active.feedback or "Tap the right food pod before Bito's timer runs down.", 640, 450, 760, 34, COLORS.coral, 0.78)

		for i, choice in ipairs(round.choices) do
			local positions = {
				{ x = 365, y = 350 },
				{ x = 565, y = 285 },
				{ x = 765, y = 350 },
				{ x = 965, y = 285 },
			}
			local pos = positions[i] or { x = 360 + i * 150, y = 310 }
			local jitter = self.low_stim and 0 or math.random(-18, 18)
			local x = pos.x + jitter
			local y = pos.y + (self.low_stim and 0 or math.random(-10, 10))
			local pod = add_box(self, "food_pod_" .. i, x, y, 150, 116, button_color(i))
			animate_pulse(self, pod, 1.035, 1.0 + (i * 0.1), i * 0.05)
			add_floating_image(self, "food_pod_icon_" .. i, tile_icon(choice), x, y + 18, 58, 58, 7, 1.2, i * 0.05)
			add_text(self, "food_pod_label_" .. i, choice, x, y - 39, 132, 28, COLORS.white, 0.5)
			self.buttons[#self.buttons + 1] = {
				id = "food_pod_" .. i,
				node = pod,
				action = function()
					if choice == round.answer then
						active.score = active.score + 1
						active.feedback = "Power-up collected!"
					else
						active.lives = active.lives - 1
						active.feedback = "Oops, that pod was a decoy."
					end
					active.round = active.round + 1
					if active.round > #active.rounds then
						active.round = 1
					end
					show_game_round(self)
				end,
			}
		end

		add_button(self, "quit_game", "Exit Game", 640, 95, 220, 48, COLORS.leaf_dark, function()
			self.active_game = nil
			show_games(self)
		end)
		return
	end
	local round = active.rounds[active.round]
	if not round then
		show_game_complete(self)
		return
	end

	clear_screen(self)
	self.screen = "game_round"
	local game = active.session.game
	add_screen_background(self)
	add_text(self, "game_title", game.name, 640, 650, 720, 50, COLORS.leaf_dark, 1.55)
	add_text(self, "score", "Round " .. active.round .. " of " .. #active.rounds .. "    Score: " .. active.score, 640, 600, 620, 36, COLORS.leaf, 1)
	add_glass_card(self, "question_panel", 640, 415, 860, 280, COLORS.glass)
	add_text(self, "question", round.prompt, 640, 485, 760, 86, COLORS.text, 1.2)
	if active.feedback ~= "" then
		add_text(self, "feedback", active.feedback, 640, 360, 620, 36, COLORS.coral, 1)
	end

	for i, choice in ipairs(round.choices) do
		local count = #round.choices
		local x = 340 + (i - 1) * 300
		local y = 265
		local w = 250
		if count > 3 then
			local col = (i - 1) % 2
			local row = math.floor((i - 1) / 2)
			x = 470 + col * 340
			y = 292 - row * 70
			w = 300
		end
		add_button(self, "choice_" .. i, choice, x, y, w, 58, button_color(i), function()
			if choice == round.answer then
				active.score = active.score + 1
				active.feedback = "Nice choice!"
			else
				active.feedback = "Good try. The food answer was " .. round.answer .. "."
			end
			active.round = active.round + 1
			show_game_round(self)
		end)
	end
	add_button(self, "quit_game", "Quit", 640, 95, 220, 48, COLORS.leaf_dark, function()
		self.active_game = nil
		show_games(self)
	end)
end

function show_game_complete(self)
	local active = self.active_game
	if not active then
		show_games(self)
		return
	end
	local earned = games.complete_session(active.session, active.score)
	msg.post("#bito_controller", "game_played", {
		game_id = active.session.game.id,
		score = active.score,
	})
	sync_wallet(self)
	clear_screen(self)
	self.screen = "game_complete"
	add_screen_background(self)
	add_glass_card(self, "complete_panel", 640, 380, 820, 360, COLORS.glass)
	local title = (active.mode == "action" or active.mode == "garden_catch") and (active.score >= active.target_score and "Mission Cleared!" or "Round Finished") or (self.low_stim and "Nice Work" or "Practice complete")
	local score_line = (active.mode == "action" or active.mode == "garden_catch") and ("Score: " .. active.score .. " / " .. active.target_score .. "\nLives left: " .. active.lives) or ("Score: " .. active.score .. " / " .. #active.rounds)
	add_text(self, "complete_title", title, 640, 500, 680, 58, COLORS.leaf_dark, 1.7)
	add_text(self, "complete_text", active.session.game.name .. "\n" .. score_line .. "\nYou earned +" .. earned .. " points.", 640, 390, 640, 110, COLORS.text, 1.1)
	self.wallet_node = add_text(self, "view_wallet", "", 640, 290, 520, 34, COLORS.leaf_dark, 1)
	update_wallet(self)
	self.active_game = nil
	add_button(self, "more_games", "More Rounds", 500, 190, 220, 52, COLORS.blue, function() show_games(self) end)
	add_button(self, "shop", "Reward Shelf", 780, 190, 220, 52, COLORS.gold, function() show_shop(self) end)
end

function show_shop(self)
	sync_wallet(self)
	clear_screen(self)
	self.screen = "shop"
	add_screen_background(self)
	add_text(self, "view_title", "Bito Upgrade Cabinet", 640, 662, 760, 58, COLORS.leaf_dark, 1.65)
	add_floating_image(self, "rewards_icon", "icon_upgrade_wrench", 350, 662, 82, 82, 8, 1.5, 0)
	add_floating_image(self, "star_icon", "icon_points_star", 930, 662, 58, 58, 8, 1.4, 0.2)
	self.wallet_node = add_text(self, "view_wallet", "", 640, 612, 520, 34, COLORS.leaf_dark, 1)
	update_wallet(self)
	add_glass_card(self, "upgrade_marquee", 640, 566, 900, 52, COLORS.glass)
	add_text(self, "shop_text", self.shop_feedback or "Use practice points for Bito parts, titles, food facts, gardens, and celebrations.", 640, 566, 810, 34, self.shop_feedback and COLORS.coral or COLORS.text, 0.76)
	self.shop_feedback = nil

	add_glass_card(self, "upgrade_floor", 640, 320, 1140, 356, vmath.vector4(0.74, 0.96, 0.88, 0.72))
	local items = shop.all()
	local shown = math.min(#items, 15)
	for i = 1, shown do
		local item = items[i]
		local col = (i - 1) % 5
		local row = math.floor((i - 1) / 5)
		local x = 190 + col * 225
		local y = 438 - row * 122
		add_upgrade_cabinet(self, item, i, x, y)
	end

	add_glass_card(self, "upgrade_tip", 640, 86, 760, 48, COLORS.glass)
	add_text(self, "upgrade_tip_text", "Owned cabinets can be tapped again to equip Bito's look.", 640, 86, 680, 28, COLORS.text, 0.68)
	add_button(self, "home", "Bito Home", 360, 34, 200, 42, COLORS.leaf, function() show_home(self) end)
	add_button(self, "customize", "Customize", 546, 34, 180, 42, COLORS.mint, function() show_customize(self) end)
	add_button(self, "games", "Practice Lab", 732, 34, 180, 42, COLORS.blue, function() show_games(self) end)
	add_button(self, "parent", "Parent Panel", 920, 34, 180, 42, COLORS.purple, function() show_parent(self) end)
end

function show_customize(self)
	sync_wallet(self)
	clear_screen(self)
	self.screen = "customize"
	add_screen_background(self)
	add_text(self, "view_title", "Bito Customizer", 640, 662, 760, 58, COLORS.leaf_dark, 1.65)
	add_floating_image(self, "customize_icon", "icon_upgrade_wrench", 350, 662, 82, 82, 8, 1.5, 0)
	self.wallet_node = add_text(self, "view_wallet", "", 640, 612, 520, 34, COLORS.leaf_dark, 1)
	update_wallet(self)

	add_glass_card(self, "custom_preview", 330, 355, 430, 430, COLORS.glass)
	add_floating_image(self, "custom_bito", "bito_robot", 330, 380, 250, 375, 14, 2.0, 0)
	add_text(self, "equipped_title", "Equipped Build", 330, 190, 330, 28, COLORS.leaf_dark, 0.86)
	add_text(self, "equipped_list", equipped_items_text(), 330, 122, 330, 100, COLORS.text, 0.62)

	add_glass_card(self, "custom_items", 820, 356, 660, 430, COLORS.glass)
	add_text(self, "custom_items_title", "Owned Upgrades", 820, 532, 540, 34, COLORS.leaf_dark, 1.0)
	local owned = {}
	for _, item in ipairs(shop.all()) do
		if shop.owned(item.id) and is_bito_custom_item(item) then
			owned[#owned + 1] = item
		end
	end
	if #owned == 0 then
		add_text(self, "no_owned_items", "No Bito customizations yet.\nPlay games for points, then buy upgrades from the cabinet.", 820, 376, 520, 100, COLORS.text, 0.82)
	else
		for i, item in ipairs(owned) do
			local col = (i - 1) % 2
			local row = math.floor((i - 1) / 2)
			local x = 700 + col * 250
			local y = 462 - row * 100
			add_custom_item_card(self, item, i, x, y)
		end
	end

	add_glass_card(self, "custom_tip", 640, 86, 760, 48, COLORS.glass)
	add_text(self, "custom_tip_text", "Buy upgrades in the cabinet, then equip them here to change Bito's build.", 640, 86, 680, 28, COLORS.text, 0.68)
	add_button(self, "home", "Bito Home", 360, 34, 180, 42, COLORS.leaf, function() show_home(self) end)
	add_button(self, "shop", "Upgrade Shop", 640, 34, 180, 42, COLORS.gold, function() show_shop(self) end)
	add_button(self, "games", "Practice Lab", 920, 34, 180, 42, COLORS.blue, function() show_games(self) end)
end

function show_parent(self)
	sync_sensory_mode(self)
	clear_screen(self)
	self.screen = "parent"
	add_screen_background(self)
	add_text(self, "view_title", "Parent Info", 640, 650, 700, 58, COLORS.leaf_dark, 1.75)
	add_floating_image(self, "parent_icon", "icon_parent", 425, 650, 82, 82, 8, 1.6, 0)
	add_glass_card(self, "parent_panel", 640, 380, 840, 390, COLORS.glass)
	add_text(self, "parent_text", parent_insight_text() .. "\n\nSensory mode: " .. (self.low_stim and "Low-Stim" or "Bright"), 640, 412, 760, 300, COLORS.text, 0.92)
	add_button(self, "toggle_sensory", self.low_stim and "Use Bright Mode" or "Use Low-Stim Mode", 500, 158, 270, 50, COLORS.purple, function()
		set_sensory_mode(self, not self.low_stim)
		show_parent(self)
	end)
	add_button(self, "home", "Home", 780, 158, 220, 50, COLORS.leaf, function() show_home(self) end)
end

local function refresh_current_screen(self)
	sync_wallet(self)
	if self.screen == "home" then
		if self.meal_status_node then gui.set_text(self.meal_status_node, self.meal_status) end
		if self.progress_node then gui.set_text(self.progress_node, self.progress_text) end
		if self.step_node then gui.set_text(self.step_node, steps_text(self.steps)) end
		if self.bito_speech_node then gui.set_text(self.bito_speech_node, self.bito_speech or "") end
		if self.bito_status_node then gui.set_text(self.bito_status_node, self.bito_status_text or "") end
		if self.energy_fill_node then
			local energy = self.bito_energy or 50
			local fill_width = math.max(10, 280 * energy / 100)
			gui.set_position(self.energy_fill_node, vmath.vector3(250 - 140 + (fill_width / 2), 322, 0))
			gui.set_size(self.energy_fill_node, vmath.vector3(fill_width, 24, 0))
		end
		if self.energy_label_node then gui.set_text(self.energy_label_node, "Energy " .. (self.bito_energy or 50) .. "%") end
	end
	update_wallet(self)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.nodes = {}
	self.buttons = {}
	self.points = 0
	self.tokens = 0
	self.meal_status = "No active meal yet."
	self.progress = 0
	self.progress_text = progress_path(0)
	self.steps = {}
	self.last_food = nil
	self.bito_speech = "Bito is checking today's mission."
	self.bito_status_text = "Bito: Scout L1"
	self.bito_energy = 50
	self.shop_feedback = nil

	local old_nodes = { "background", "title", "subtitle", "meal_status", "progress", "wallet", "arcade_title", "games" }
	for _, id in ipairs(old_nodes) do
		local node = safe_get_node(id)
		if node then gui.set_enabled(node, false) end
	end

	show_intro(self)
end

function on_message(self, message_id, message, sender)
	if message.points then self.points = message.points end
	if message.tokens then self.tokens = message.tokens end

	if message_id == hash("app_ready") then
		local was_low_stim = self.low_stim
		sync_sensory_mode(self)
		if was_low_stim ~= self.low_stim then
			show_intro(self)
		else
			refresh_current_screen(self)
		end
	elseif message_id == hash("meal_started") then
		self.last_food = message.food
		self.steps = message.steps or self.steps or {}
		self.meal_status = "Current food challenge: " .. message.food
		self.progress = 0
		self.progress_text = progress_path(0)
		refresh_current_screen(self)
	elseif message_id == hash("meal_progress") then
		self.last_food = message.food
		self.steps = message.steps or self.steps or {}
		self.progress = message.progress or self.progress or 0
		self.meal_status = "Buddy is eating with you. Plate: " .. message.grams .. "g"
		self.progress_text = progress_path(self.progress)
		refresh_current_screen(self)
	elseif message_id == hash("meal_complete") then
		self.last_food = message.food
		self.steps = message.steps or self.steps or {}
		self.meal_status = "Meal complete! You earned 3 practice tokens."
		self.progress = 100
		self.progress_text = progress_path(100)
		refresh_current_screen(self)
	elseif message_id == hash("plate_status") then
		if message.status == "calibrating" then
			self.meal_status = "Magic calibration: plate is getting ready."
		elseif message.status == "connected" then
			self.meal_status = "Plate is awake and ready."
		elseif message.status == "disconnected" then
			self.meal_status = "Plate is taking a nap. We can try again soon."
		end
		refresh_current_screen(self)
	elseif message_id == hash("bito_status") then
		self.bito_speech = message.speech
		self.bito_energy = message.energy_level or self.bito_energy or 50
		self.bito_status_text = "Bito: " .. (message.current_form or "Scout") .. " L" .. (message.level or 1) .. " Energy " .. (message.energy_level or 0) .. "%"
		refresh_current_screen(self)
	end
end

function update(self, dt)
	if self.screen == "game_round" and self.active_game and self.active_game.mode == "garden_catch" then
		local active = self.active_game
		active.time_left = math.max(0, (active.time_left or 0) - dt)
		active.spawn_timer = (active.spawn_timer or 0) - dt
		if active.spawn_timer <= 0 then
			spawn_garden_catch_item(self, active)
			active.spawn_timer = self.low_stim and 0.95 or 0.55
		end
		active.basket_x = math.max(150, math.min(1130, self.cursor_x or active.basket_x or 640))
		if self.basket_node then gui.set_position(self.basket_node, vmath.vector3(active.basket_x, 105, 0)) end
		if self.basket_label_node then gui.set_position(self.basket_label_node, vmath.vector3(active.basket_x, 103, 0)) end
		if self.action_hud_node then
			gui.set_text(self.action_hud_node, "Healthy caught " .. active.score .. "/" .. active.target_score .. "    Lives " .. active.lives .. "    Time " .. math.ceil(active.time_left))
		end

		for i = #active.falling, 1, -1 do
			local item = active.falling[i]
			item.y = item.y - (item.speed * dt)
			gui.set_position(item.node, vmath.vector3(item.x, item.y, 0))
			gui.set_position(item.icon, vmath.vector3(item.x, item.y + 9, 0))
			gui.set_position(item.label, vmath.vector3(item.x, item.y - 30, 0))
			local caught_by_basket = item.y <= 142 and item.y >= 78 and math.abs(item.x - active.basket_x) < 100
			if caught_by_basket then
				if item.healthy then
					active.score = active.score + 1
				else
					active.lives = active.lives - 1
				end
				gui.delete_node(item.node)
				gui.delete_node(item.icon)
				gui.delete_node(item.label)
				table.remove(active.falling, i)
			elseif item.y < 42 then
				if item.healthy then
					active.lives = active.lives - 1
				end
				gui.delete_node(item.node)
				gui.delete_node(item.icon)
				gui.delete_node(item.label)
				table.remove(active.falling, i)
			end
		end

		if active.score >= active.target_score or active.lives <= 0 or active.time_left <= 0 then
			show_game_complete(self)
		end
		return
	end
	if self.screen == "game_round" and self.active_game and self.active_game.mode == "action" then
		local active = self.active_game
		active.time_left = math.max(0, (active.time_left or 0) - dt)
		if self.action_hud_node then
			gui.set_text(self.action_hud_node, "Score " .. active.score .. "/" .. active.target_score .. "    Lives " .. active.lives .. "    Time " .. math.ceil(active.time_left))
		end
		if active.time_left <= 0 then
			show_game_complete(self)
		end
	end
end

function on_input(self, action_id, action)
	if (action_id == hash("click") or action_id == hash("touch_multi")) then
		if action.x then
			self.cursor_x = action.x
		end
		if action.touch and action.touch[1] then
			self.cursor_x = action.touch[1].x
		end
	end
	if (action_id == hash("click") or action_id == hash("touch_multi")) and action.pressed then
		local x = action.x
		local y = action.y
		if action.touch and action.touch[1] then
			x = action.touch[1].x
			y = action.touch[1].y
		end
		if not x or not y then
			return false
		end
		for _, button in ipairs(self.buttons) do
			if gui.pick_node(button.node, x, y) then
				button.action()
				return true
			end
		end
	end
end
