local show_intro
local show_home
local show_games
local show_shop
local show_customize
local show_parent
local show_game_start
local show_game_round
local show_game_complete
local show_game_transition
local sync_sensory_mode
local button_color
local tile_icon

local function safe_get_node(id)
	local ok, node = pcall(gui.get_node, id)
	if ok then
		return node
	end
	return nil
end

local function add_box(self, id, x, y, w, h, color)
	local node = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(w, h, 0))
	gui.set_id(node, id)
	gui.set_color(node, color)
	self.nodes[#self.nodes + 1] = node
	return node
end

local function add_text(self, id, text, x, y, w, h, color, scale)
	local node = gui.new_text_node(vmath.vector3(x, y, 0), text)
	gui.set_id(node, id)
	gui.set_font(node, "text")
	gui.set_size(node, vmath.vector3(w, h, 0))
	gui.set_color(node, color or COLORS.text)
	gui.set_line_break(node, true)
	gui.set_scale(node, vmath.vector3(scale or 1, scale or 1, 1))
	self.nodes[#self.nodes + 1] = node
	return node
end

local function add_image(self, id, texture, x, y, w, h)
	local node = add_box(self, id, x, y, w, h, COLORS.white)
	gui.set_texture(node, texture)
	return node
end

local function animate_bob(self, node, x, y, amount, duration, delay)
	if self.low_stim then
		return
	end
	pcall(gui.animate, node, gui.PROP_POSITION, vmath.vector3(x, y + amount, 0), gui.EASING_INOUTSINE, duration, delay or 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

local function animate_pulse(self, node, scale, duration, delay)
	if self.low_stim then
		return
	end
	pcall(gui.animate, node, gui.PROP_SCALE, vmath.vector3(scale, scale, 1), gui.EASING_INOUTSINE, duration, delay or 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

local function add_floating_image(self, id, texture, x, y, w, h, amount, duration, delay)
	local node = add_image(self, id, texture, x, y, w, h)
	animate_bob(self, node, x, y, amount or 12, duration or 1.8, delay or 0)
	return node
end

local function add_screen_background(self)
	add_box(self, "screen_paper", 640, 360, 1280, 720, COLORS.bg)
	add_box(self, "screen_field", 1085, 360, 390, 720, self.low_stim and COLORS.panel or COLORS.card)
	add_box(self, "screen_rule", 884, 360, 4, 720, COLORS.coral)
	add_box(self, "screen_top_rule", 640, 686, 1160, 2, COLORS.leaf_dark)
end

local function add_glass_card(self, id, x, y, w, h, color)
	add_box(self, id .. "_shadow", x + 6, y - 6, w, h, COLORS.shadow)
	add_box(self, id .. "_base", x, y, w, h, color or COLORS.glass)
end

local function add_energy_tube(self, id, x, y, w, h, pct)
	local clamped = math.max(0, math.min(100, pct or 0))
	add_box(self, id .. "_shadow", x + 5, y - 6, w, h, COLORS.shadow)
	add_box(self, id .. "_shell", x, y, w, h, vmath.vector4(1, 1, 1, 0.72))
	self.energy_fill_node = add_box(self, id .. "_fill", x - (w / 2) + ((w * clamped / 100) / 2), y, math.max(10, w * clamped / 100), h - 10, COLORS.tube)
	add_box(self, id .. "_shine", x, y + (h * 0.16), w * 0.88, math.max(4, h * 0.15), vmath.vector4(1, 1, 1, 0.35))
	return self.energy_fill_node
end

local function add_accent_ribbon(self)
	add_box(self, "ribbon_top_leaf", 220, 704, 440, 32, COLORS.leaf)
	add_box(self, "ribbon_top_sky", 640, 704, 400, 32, COLORS.sky)
	add_box(self, "ribbon_top_coral", 1040, 704, 480, 32, COLORS.coral)
	add_box(self, "ribbon_bottom_gold", 230, 16, 460, 32, COLORS.gold)
	add_box(self, "ribbon_bottom_mint", 680, 16, 440, 32, COLORS.mint)
	add_box(self, "ribbon_bottom_pink", 1070, 16, 420, 32, COLORS.pink)
end

local function clear_screen(self)
	sync_sensory_mode(self)
	for _, node in ipairs(self.nodes) do
		gui.delete_node(node)
	end
	self.nodes = {}
	self.buttons = {}
end

local function add_button(self, id, label, x, y, w, h, color, action)
	add_box(self, id .. "_button_shadow", x + 4, y - 7, w, h, COLORS.shadow)
	local box = add_box(self, id .. "_box", x, y, w, h, color)
	add_box(self, id .. "_button_shine", x, y + (h * 0.24), w * 0.82, math.max(6, h * 0.16), vmath.vector4(1, 1, 1, 0.28))
	add_text(self, id .. "_label", label, x, y - 2, w - 20, h - 10, COLORS.white, 0.88)
	animate_pulse(self, box, 1.025, 1.4, (#self.buttons % 4) * 0.08)
	self.buttons[#self.buttons + 1] = { id = id, node = box, action = action }
	return box
end

local function game_icon(game_id)
	local icons = {
		food_match = "food_apple",
		garden_catch = "food_strawberry",
		plate_builder = "plate_balanced",
		texture_sort = "food_carrot",
		color_plate = "food_broccoli",
		memory_meal = "food_yogurt",
		food_maze = "food_rice",
		snack_tap = "food_banana",
		recipe_order = "food_beans",
		nutrient_quest = "food_milk",
	}
	return icons[game_id] or "icon_games"
end

local function add_arcade_card(self, game, index, x, y)
	local ready = self.tokens >= game.cost
	local cabinet_color = ready and button_color(index) or COLORS.leaf_dark
	local card = add_box(self, "arcade_card_" .. game.id, x, y, 210, 142, cabinet_color)
	animate_pulse(self, card, 1.02, 1.5, index * 0.04)
	add_box(self, "arcade_screen_" .. game.id, x, y + 18, 174, 74, ready and COLORS.card or COLORS.panel)
	add_floating_image(self, "arcade_icon_" .. game.id, game_icon(game.id), x - 56, y + 20, 52, 52, 5, 1.4, index * 0.04)
	add_text(self, "arcade_name_" .. game.id, game.name, x + 34, y + 33, 104, 34, COLORS.leaf_dark, 0.62)
	add_text(self, "arcade_meta_" .. game.id, game.duration .. "s  +" .. game.point_reward .. " pts", x + 34, y + 2, 112, 24, COLORS.text, 0.52)
	add_box(self, "arcade_coin_slot_" .. game.id, x - 56, y - 52, 74, 26, COLORS.gold)
	add_text(self, "arcade_cost_" .. game.id, game.cost .. " token", x - 56, y - 55, 66, 20, COLORS.leaf_dark, 0.46)
	add_text(self, "arcade_ready_" .. game.id, ready and "READY" or "LOCKED", x + 42, y - 54, 96, 22, COLORS.white, 0.54)
	self.buttons[#self.buttons + 1] = {
		id = "play_" .. game.id,
		node = card,
		action = function()
			show_game_start(self, game.id)
		end,
	}
end

local function item_icon(item)
	local icons = {
		bito_core = "buddy_food",
		bito_armor = "icon_upgrade_wrench",
		bito_trail = "icon_points_star",
		buddy = "buddy_food",
		plate = "plate_balanced",
		food_fact = "icon_glossary",
		garden = "decor_leaf",
		title = "icon_rewards",
		celebration = "decor_star",
	}
	return icons[item.category] or "icon_rewards"
end

function tile_icon(label)
	local text = string.lower(label or "")
	if string.find(text, "apple") then return "food_apple" end
	if string.find(text, "banana") then return "food_banana" end
	if string.find(text, "broccoli") or string.find(text, "peas") or string.find(text, "spinach") or string.find(text, "lettuce") then return "food_broccoli" end
	if string.find(text, "carrot") or string.find(text, "pumpkin") or string.find(text, "sweet potato") then return "food_carrot" end
	if string.find(text, "yogurt") or string.find(text, "milk") or string.find(text, "cheese") then return "food_milk" end
	if string.find(text, "rice") or string.find(text, "oatmeal") or string.find(text, "bread") or string.find(text, "grain") then return "food_rice" end
	if string.find(text, "chicken") or string.find(text, "egg") or string.find(text, "protein") then return "food_chicken" end
	if string.find(text, "beans") then return "food_beans" end
	if string.find(text, "strawberry") or string.find(text, "blueberry") or string.find(text, "grape") then return "food_strawberry" end
	if string.find(text, "token") then return "icon_arcade_token" end
	if string.find(text, "power") then return "icon_points_star" end
	return "icon_heart_food"
end

local HEALTHY_FALLING_FOODS = {
	{ name = "Apple", icon = "food_apple" },
	{ name = "Banana", icon = "food_banana" },
	{ name = "Carrot", icon = "food_carrot" },
	{ name = "Broccoli", icon = "food_broccoli" },
	{ name = "Strawberry", icon = "food_strawberry" },
	{ name = "Milk", icon = "food_milk" },
	{ name = "Beans", icon = "food_beans" },
}

local DESSERT_DECOYS = {
	{ name = "Cupcake", icon = "icon_heart_food" },
	{ name = "Candy", icon = "icon_points_star" },
	{ name = "Soda", icon = "icon_arcade_token" },
}

local function spawn_garden_catch_item(self, active)
	local healthy = math.random() < 0.72
	local list = healthy and HEALTHY_FALLING_FOODS or DESSERT_DECOYS
	local item = list[math.random(#list)]
	local x = math.random(170, 1110)
	local y = 584
	local color = healthy and COLORS.leaf or COLORS.coral
	local node = add_box(self, "falling_food_" .. active.spawn_count, x, y, 88, 88, color)
	local icon = add_image(self, "falling_icon_" .. active.spawn_count, item.icon, x, y + 9, 48, 48)
	local label = add_text(self, "falling_label_" .. active.spawn_count, healthy and "GOOD" or "AVOID", x, y - 30, 78, 20, COLORS.white, 0.44)
	active.falling[#active.falling + 1] = {
		node = node,
		icon = icon,
		label = label,
		x = x,
		y = y,
		speed = healthy and math.random(120, 180) or math.random(150, 220),
		healthy = healthy,
		name = item.name,
		caught = false,
	}
	active.spawn_count = active.spawn_count + 1
end

local function add_upgrade_cabinet(self, item, index, x, y)
	local owned = shop.owned(item.id)
	local affordable = self.points >= item.cost
	local state_text = owned and "OWNED" or (affordable and "BUY" or "LOCKED")
	local cabinet_color = owned and COLORS.leaf or (affordable and button_color(index) or COLORS.leaf_dark)
	local card = add_box(self, "upgrade_card_" .. item.id, x, y, 220, 134, cabinet_color)
	animate_pulse(self, card, 1.018, 1.6, index * 0.05)
	add_box(self, "upgrade_screen_" .. item.id, x, y + 18, 184, 72, owned and COLORS.mint or COLORS.card)
	add_floating_image(self, "upgrade_icon_" .. item.id, item_icon(item), x - 66, y + 21, 50, 50, 5, 1.4, index * 0.04)
	add_text(self, "upgrade_name_" .. item.id, item.name, x + 36, y + 34, 118, 32, COLORS.leaf_dark, 0.58)
	add_text(self, "upgrade_desc_" .. item.id, item.desc, x + 36, y + 4, 122, 38, COLORS.text, 0.42)
	add_box(self, "upgrade_slot_" .. item.id, x - 62, y - 50, 82, 26, COLORS.gold)
	add_text(self, "upgrade_cost_" .. item.id, item.cost .. " pts", x - 62, y - 53, 72, 20, COLORS.leaf_dark, 0.46)
	add_text(self, "upgrade_state_" .. item.id, state_text, x + 44, y - 53, 96, 22, COLORS.white, 0.52)
	self.buttons[#self.buttons + 1] = {
		id = "buy_" .. item.id,
		node = card,
		action = function()
			if owned then
				local ok = shop.equip(item.id)
				self.shop_feedback = ok and (item.name .. " equipped on Bito.") or (item.name .. " is already unlocked.")
				show_shop(self)
				return
			end
			local ok, result = shop.buy(item.id)
			if ok then
				shop.equip(item.id)
				sync_wallet(self)
				self.shop_feedback = item.name .. " bought! Points left: " .. self.points
				show_shop(self)
			else
				self.shop_feedback = result == "not_enough_points" and ("Need " .. item.cost .. " points for " .. item.name .. ".") or "This upgrade is not available right now."
				show_shop(self)
			end
		end,
	}
end

local function equipped_items_text()
	local s = storage.get_state()
	local equipped = s and s.inventory and s.inventory.equipped or {}
	local lines = {
		"Core: " .. (equipped.bito_core or "none"),
		"Armor: " .. (equipped.bito_armor or "none"),
		"Trail: " .. (equipped.bito_trail or "none"),
		"Title: " .. (equipped.title or "none"),
		"Celebration: " .. (equipped.celebration or "none"),
	}
	return table.concat(lines, "\n")
end

local function is_bito_custom_item(item)
	return item.category == "bito_core"
		or item.category == "bito_armor"
		or item.category == "bito_trail"
		or item.category == "title"
		or item.category == "celebration"
end

local function add_custom_item_card(self, item, index, x, y)
	local s = storage.get_state()
	local equipped = s and s.inventory and s.inventory.equipped or {}
	local is_equipped = equipped[item.category] == item.id
	local color = is_equipped and COLORS.leaf or button_color(index)
	local card = add_box(self, "custom_card_" .. item.id, x, y, 230, 86, color)
	animate_pulse(self, card, 1.018, 1.4, index * 0.04)
	add_floating_image(self, "custom_icon_" .. item.id, item_icon(item), x - 82, y + 3, 52, 52, 5, 1.4, index * 0.03)
	add_text(self, "custom_name_" .. item.id, item.name, x + 28, y + 17, 138, 28, COLORS.white, 0.56)
	add_text(self, "custom_state_" .. item.id, is_equipped and "EQUIPPED" or "TAP TO EQUIP", x + 28, y - 18, 138, 24, COLORS.white, 0.46)
	self.buttons[#self.buttons + 1] = {
		id = "equip_" .. item.id,
		node = card,
		action = function()
			local ok = shop.equip(item.id)
			show_message(self, ok and "Bito Updated" or "Could Not Equip", ok and (item.name .. " is now active.") or "This item cannot be equipped yet.", function() show_customize(self) end)
		end,
	}
end

local function sync_wallet(self)
	local ok_points, points = pcall(rewards.get_points)
	local ok_tokens, tokens = pcall(rewards.get_tokens)
	self.points = ok_points and points or self.points or 0
	self.tokens = ok_tokens and tokens or self.tokens or 0
end

function sync_sensory_mode(self)
	local ok, state = pcall(storage.get_state)
	local mode = ok and state and state.child and state.child.sensory_mode or "bright"
	self.low_stim = mode == "low_stim"
	COLORS = self.low_stim and LOW_STIM_COLORS or NORMAL_COLORS
end

local function set_sensory_mode(self, low_stim)
	local s = storage.get_state()
	s.child.sensory_mode = low_stim and "low_stim" or "bright"
	storage.save_state(s)
	sync_sensory_mode(self)
end

local function update_wallet(self)
	if self.wallet_node then
		gui.set_text(self.wallet_node, "Points: " .. self.points .. "    Tokens: " .. self.tokens)
	end
end

local function progress_path(progress)
	local filled = math.floor((progress or 0) / 10)
	local path = ""
	for i = 1, 10 do
		path = path .. (i <= filled and "=" or "-")
	end
	return "Food path: [" .. path .. "] " .. (progress or 0) .. "%"
end

local function steps_text(steps)
	steps = steps or {}
	local function mark(key)
		return steps[key] and "done" or "next"
	end
	return "Steps: Look " .. mark("look") .. " | Touch/Smell " .. mark("interact") .. " | Taste " .. mark("taste") .. " | Eat " .. mark("complete")
end

local function parent_insight_text()
	local ok, s = pcall(storage.get_state)
	if not ok or not s then
		return "Parent insights will appear after the first food challenge."
	end
	local texture_counts = {}
	local color_counts = {}
	for _, food in ipairs(s.glossary or {}) do
		local completed = food.steps and (food.steps.complete or 0) or 0
		if completed > 0 then
			texture_counts[food.texture or "Unknown"] = (texture_counts[food.texture or "Unknown"] or 0) + completed
			color_counts[food.color or "Unknown"] = (color_counts[food.color or "Unknown"] or 0) + completed
		end
	end
	local top_texture, top_texture_count = "not enough data yet", 0
	for texture, count in pairs(texture_counts) do
		if count > top_texture_count then
			top_texture = texture
			top_texture_count = count
		end
	end
	local top_color, top_color_count = "not enough data yet", 0
	for color, count in pairs(color_counts) do
		if count > top_color_count then
			top_color = color
			top_color_count = count
		end
	end
	return "Food IEP snapshot:\n\nStrongest texture pattern: " .. top_texture .. "\nStrongest color pattern: " .. top_color .. "\nMeals completed: " .. (s.metrics.meals_completed or 0) .. "\nFoods introduced: " .. (s.metrics.new_foods or 0)
end

local function bridge_round(food)
	if not food then
		return nil
	end
	local other = food == "Carrot" and "Apple" or "Carrot"
	return {
		prompt = "Plate power-up: choose the food you just practiced.",
		choices = { food, other, "Soda" },
		answer = food,
	}
end

function button_color(index)
	local colors = { COLORS.leaf, COLORS.blue, COLORS.coral, COLORS.gold, COLORS.purple, COLORS.pink }
	return colors[((index - 1) % #colors) + 1]
end

local function show_message(self, title, message, back_action)
	clear_screen(self)
	self.screen = "message"
	add_box(self, "bg", 640, 360, 1280, 720, COLORS.bg)
	add_box(self, "message_panel", 640, 380, 780, 340, COLORS.panel)
	add_text(self, "message_title", title, 640, 485, 680, 58, COLORS.leaf_dark, 1.6)
	add_text(self, "message_body", message, 640, 390, 640, 120, COLORS.text, 1)
	add_button(self, "message_back", "OK", 640, 260, 240, 52, COLORS.leaf, back_action or function()
		show_games(self)
	end)
end

